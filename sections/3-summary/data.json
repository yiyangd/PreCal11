      {
        "id": "exponentials",
        "title": "指数函数与利息",
        "summary": "$a>0,a\\ne1$。$a^x$定义域$\\mathbb R$、值域$(0,\\infty)$、过$(0,1),(1,a)$、水平渐近线$y=0$。$a>1$递增，$0<a<1$递减。",
        "method": [
          {
            "title": "方法",
            "body": "指数法则：$a^xa^y=a^{x+y}$，$a^x/a^y=a^{x-y}$，$(a^x)^y=a^{xy}$。单利$I=Prt,A=P+Prt$；复利$A=P(1+r/n)^{nt}$；连续复利$A=Pe^{rt}$，$e\\approx2.71828$。"
          }
        ],
        "pitfalls": [],
        "en": {
          "title": "Exponential functions and interest",
          "summary": "For $a>0,a\\ne1$, $a^x$ has domain $\\mathbb R$, range $(0,\\infty)$, points $(0,1),(1,a)$, and asymptote $y=0$. It increases for $a>1$ and decreases for $0<a<1$.",
          "method": [
            {
              "title": "Method",
              "body": "Exponent rules: $a^xa^y=a^{x+y}$, $a^x/a^y=a^{x-y}$, $(a^x)^y=a^{xy}$. Simple interest $I=Prt,A=P+Prt$; compound interest $A=P(1+r/n)^{nt}$; continuous compounding $A=Pe^{rt}$, $e\\approx2.71828$."
            }
          ],
          "pitfalls": []
        }
      },
      {
        "id": "logarithms",
        "title": "对数函数与反函数",
        "summary": "$y=\\log_a x\\iff x=a^y$，$x>0,a>0,a\\ne1$。定义域$(0,\\infty)$、值域$\\mathbb R$、截距$(1,0)$、竖直渐近线$x=0$。",
        "method": [
          {
            "title": "方法",
            "body": "$\\log_a1=0,\\log_a a=1,\\log_a(a^x)=x,a^{\\log_a x}=x$。$\\log x=\\log_{10}x$，$\\ln x=\\log_e x$。"
          }
        ],
        "pitfalls": [],
        "en": {
          "title": "Logarithmic functions and inverses",
          "summary": "$y=\\log_a x\\iff x=a^y$ with $x>0,a>0,a\\ne1$. Domain $(0,\\infty)$, range $\\mathbb R$, intercept $(1,0)$, and vertical asymptote $x=0$.",
          "method": [
            {
              "title": "Method",
              "body": "$\\log_a1=0,\\log_a a=1,\\log_a(a^x)=x,a^{\\log_a x}=x$. Common log $\\log x=\\log_{10}x$; natural log $\\ln x=\\log_e x$."
            }
          ],
          "pitfalls": []
        }
      },
      {
        "id": "rules",
        "title": "对数运算法则",
        "summary": "正真数$M,N$：$\\log_a(MN)=\\log_aM+\\log_aN$，$\\log_a(M/N)=\\log_aM-\\log_aN$。",
        "method": [
          {
            "title": "方法",
            "body": "$\\log_a(M^r)=r\\log_aM$；换底$\\log_bx=\\ln x/\\ln b$。半衰期$Q=Q_0(1/2)^{t/h}$。"
          }
        ],
        "pitfalls": [],
        "en": {
          "title": "Rules of logarithms",
          "summary": "For positive $M,N$, $\\log_a(MN)=\\log_aM+\\log_aN$ and $\\log_a(M/N)=\\log_aM-\\log_aN$.",
          "method": [
            {
              "title": "Method",
              "body": "$\\log_a(M^r)=r\\log_aM$; change base $\\log_bx=\\ln x/\\ln b$. Half-life $Q=Q_0(1/2)^{t/h}$."
            }
          ],
          "pitfalls": []
        }
      },
      {
        "id": "equations",
